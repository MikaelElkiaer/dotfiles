#!/usr/bin/env bash

set -Eeuo pipefail

SELF="$(command -v supermux 2>/dev/null || echo "$0")"

SCRIPT_DIR="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
source "$SCRIPT_DIR/shortname" 2>/dev/null || true
source "$SCRIPT_DIR/set-color" 2>/dev/null || true
source "$SCRIPT_DIR/shortpath" 2>/dev/null || true
source "$SCRIPT_DIR/pathmux" 2>/dev/null || true
source "$SCRIPT_DIR/windowmux" 2>/dev/null || true
source "$SCRIPT_DIR/kubemux" 2>/dev/null || true

function shorten_path {
  shortpath -S "$1"
}

function get_pad_width {
  local pane_w
  pane_w="$(tmux display-message -p '#{pane_width}' 2>/dev/null || echo "")"
  local width="${pane_w:-${COLUMNS:-$(tput cols 2>/dev/null || echo 120)}}"
  echo $(( width + 20 ))
}

function get_tmux_sessions {
  local current_sess_id
  current_sess_id="$(tmux display-message -p '#{session_id}' 2>/dev/null || true)"

  local pad
  pad="$(printf '%*s' "$(get_pad_width)" '')"

  tmux list-sessions -F "#{session_id};#{session_name};#{session_activity};#{session_active};#{window_id};#{pane_current_path};#{pane_current_command};#{pane_title};#{window_bell_flag}" -f '#{?#{m:_popup_*,#{session_name}},0,1}' 2>/dev/null | \
    while IFS=';' read -r sess_id sess_name sess_activity sess_active win_id pane_path pane_cmd pane_title win_bell || [[ -n "$sess_id" ]]; do
      if [ -n "$current_sess_id" ] && [ "$sess_id" = "$current_sess_id" ]; then
        continue
      fi
      local kube_ctx=""
      local clean_id="${sess_id#\$}"
      if [ -f "$HOME/.kube/config-tmux-$clean_id" ]; then
        kube_ctx=$(kubemux "$sess_id")
      fi
      local win_path=""
      if [ -n "$pane_path" ]; then
        win_path="$(format_path "$pane_path" "$pane_cmd" "$pane_title" "$win_bell")"
      fi
      local display_name
      if [ -n "$win_path" ]; then
        display_name="${win_path}${kube_ctx:+ $kube_ctx}"
      else
        display_name="$sess_name${kube_ctx:+ $kube_ctx}"
      fi

      local unshortened_path="$pane_path"
      if [ -n "${HOME:-}" ] && [[ "$unshortened_path" == "$HOME"* ]]; then
        unshortened_path="~${unshortened_path#$HOME}"
      fi
      local search_text="$unshortened_path $pane_path $sess_name"
      local name="${display_name}${pad}${search_text}"

      echo -e "$sess_id\t$name\t${sess_activity:-0}"
    done
}

function get_tmux_windows {
  local pad
  pad="$(printf '%*s' "$(get_pad_width)" '')"

  declare -A win_cmds
  while IFS=';' read -r wid cmd; do
    [ -n "$wid" ] && win_cmds["$wid"]="${win_cmds["$wid"]:-} $cmd"
  done < <(tmux list-panes -s -F "#{window_id};#{pane_current_command}" 2>/dev/null || true)

  tmux list-windows -F "#{window_id};#{window_active};#{session_id};#{window_activity};#{window_name};#{pane_current_path};#{pane_current_command};#{pane_title};#{window_bell_flag}" 2>/dev/null | \
    while IFS=';' read -r win_id win_active sess_id win_act win_name pane_path pane_cmd pane_title win_bell || [[ -n "$sess_id" ]]; do
      if [ "$win_active" = "1" ]; then
        continue
      fi
      local win_id_clean="${win_id//\'/}"
      local win_icons win_path
      win_icons="$(windowmux "$win_id_clean" active)"
      if [ -n "$pane_path" ]; then
        win_path="$(format_path "$pane_path" "$pane_cmd" "$pane_title" 0)"
      else
        win_path=""
      fi
      # Display path BEFORE pane icons (no kubemux)
      local display_name="${win_path:+${win_path} }${win_icons}"

      local unshortened_path="$pane_path"
      if [ -n "${HOME:-}" ] && [[ "$unshortened_path" == "$HOME"* ]]; then
        unshortened_path="~${unshortened_path#$HOME}"
      fi
      local procs="${win_cmds["$win_id"]:-$pane_cmd}"
      local search_text="$unshortened_path $pane_path $procs $win_name $pane_title"
      local name="${display_name}${pad}${search_text}"

      echo -e "$win_id\t$name\t${win_act:-0}"
    done
}

function zoxide_query {
  local pad
  pad="$(printf '%*s' "$(get_pad_width)" '')"

  zoxide query --list --score 2>/dev/null | while read -r score full_path || [ -n "$full_path" ]; do
    [ -z "$full_path" ] && continue
    local short_p
    short_p="$(shortpath -S "$full_path")"
    local tilda_p="$full_path"
    if [ -n "${HOME:-}" ] && [[ "$tilda_p" == "$HOME"* ]]; then
      tilda_p="~${tilda_p#$HOME}"
    fi
    echo -e "$full_path\t${short_p}${pad}${tilda_p} ${full_path}\t$score"
  done || true
}

function tmux_new_session {
  local dir="$1"
  local cmd="${2:-}"
  local new_id
  if [ -n "$cmd" ]; then
    new_id="$(tmux new-session -d -c "$dir" -P -F '#{session_id}' bash -i -c "$cmd; exec bash")"
  else
    new_id="$(tmux new-session -d -c "$dir" -P -F '#{session_id}' bash)"
  fi
  tmux switch-client -t "$new_id"
}

function find_session_by_path {
  local target_dir="$1"
  [ -z "$target_dir" ] && return 1
  target_dir="${target_dir%/}"

  local sess_id sess_name pane_path
  while IFS=';' read -r sess_id sess_name pane_path; do
    pane_path="${pane_path%/}"
    if [ "$pane_path" = "$target_dir" ] || [ "$pane_path" -ef "$target_dir" ]; then
      echo "$sess_id;$sess_name"
      return 0
    fi
  done < <(tmux list-windows -a -F "#{session_id};#{session_name};#{pane_current_path}" 2>/dev/null || true)
  return 1
}

function find_session_by_kube {
  local target_cluster="$1"
  [ -z "$target_cluster" ] && return 1

  local sess_id sess_name
  while IFS=';' read -r sess_id sess_name; do
    local clean_id="${sess_id#\$}"
    local cfg="$HOME/.kube/config-tmux-$clean_id"
    if [ -f "$cfg" ] && grep -q -F "$target_cluster" "$cfg" 2>/dev/null; then
      echo "$sess_id;$sess_name"
      return 0
    fi
  done < <(tmux list-sessions -F "#{session_id};#{session_name}" 2>/dev/null || true)
  return 1
}

function prompt_session_conflict {
  local existing_id="$1"
  local existing_name="$2"
  local type="$3"
  local value="$4"

  local c_warn=$'\033[38;5;3m'
  local c_bold=$'\033[1m'
  local c_cyan=$'\033[38;5;6m'
  local c_reset=$'\033[0m'

  echo ""
  echo -e "${c_warn}Warning:${c_reset} An active session already has this ${type}:"
  echo -e "  ${c_cyan}${value}${c_reset} -> Session ${c_bold}${existing_name}${c_reset} (${existing_id})"
  echo ""
  echo -e "Options: [${c_bold}s${c_reset}]witch to existing  [${c_bold}c${c_reset}]reate new anyway  [${c_bold}a${c_reset}]bort"

  local choice
  read -r -n 1 -p "Choice (s/c/a) [s]: " choice < /dev/tty || choice=""
  echo ""

  case "${choice:-s}" in
    s|S|"")
      tmux switch-client -t "$existing_id"
      return 1
      ;;
    c|C)
      return 0
      ;;
    *)
      return 2
      ;;
  esac
}

function zoxide_open {
  local dir="$1"
  local cmd="${2:-}"

  local conflict
  if conflict="$(find_session_by_path "$dir")"; then
    local sess_id="${conflict%%;*}"
    local sess_name="${conflict#*;}"
    prompt_session_conflict "$sess_id" "$sess_name" "path" "$dir"
    local action=$?
    if [ "$action" -ne 0 ]; then
      return 0
    fi
  fi

  tmux_new_session "$dir" "$cmd"
}

function ic_connect {
  local cluster="$1"
  local cmd="${2:-}"

  local conflict
  if conflict="$(find_session_by_kube "$cluster")"; then
    local sess_id="${conflict%%;*}"
    local sess_name="${conflict#*;}"
    prompt_session_conflict "$sess_id" "$sess_name" "kube context" "$cluster"
    local action=$?
    if [ "$action" -ne 0 ]; then
      return 0
    fi
  fi

  local new_id
  new_id="$(tmux new-session -c "$HOME" -d -e "KUBECACHEDIR=$HOME/.kube/cache" -P -F '#{session_id}' bash -i -c "${cmd:+$cmd; }exec bash")"
  local new_name="${new_id#\$}"
  ic get cluster-kubeconfig --cluster-name "$cluster" >"$HOME/.kube/config-tmux-${new_name}"
  tmux switch-client -t "$new_id"
}

function get_github_user {
  local user=""
  if [ -f "$HOME/.config/gh/hosts.yml" ]; then
    while IFS= read -r line; do
      if [[ "$line" =~ ^[[:space:]]*user:[[:space:]]*([^[:space:]]+) ]]; then
        user="${BASH_REMATCH[1]}"
        break
      fi
    done <"$HOME/.config/gh/hosts.yml"
  fi
  if [ -z "$user" ]; then
    user="$(gh api user -q .login 2>/dev/null || echo "")"
  fi
  echo "$user"
}

function github_clone_and_open {
  local full_name="$1"
  local cmd="${2:-}"

  [ -z "$full_name" ] && return 0

  local owner="${full_name%%/*}"
  local name="${full_name#*/}"
  local user
  user="$(get_github_user)"

  local subpath
  if [ -n "$user" ] && [ "$user" = "$owner" ]; then
    subpath="$name"
  else
    subpath="$owner/$name"
  fi

  local base_dir="${HOME}/Repositories/GitHub"
  local target_dir="$base_dir/$subpath"

  if [ -d "$target_dir" ]; then
    local conflict
    if conflict="$(find_session_by_path "$target_dir")"; then
      local sess_id="${conflict%%;*}"
      local sess_name="${conflict#*;}"
      prompt_session_conflict "$sess_id" "$sess_name" "path" "$target_dir"
      local action=$?
      if [ "$action" -ne 0 ]; then
        return 0
      fi
    fi
  else
    mkdir -p "$(dirname "$target_dir")"
    gh repo clone "$full_name" "$target_dir"
    if command -v zoxide &>/dev/null; then
      zoxide add "$target_dir" 2>/dev/null || true
    fi
  fi

  tmux_new_session "$target_dir" "$cmd"
}

function supermux_github_query {
  local query="$1"
  pkill -f supermux-gh-query 2>/dev/null || true
  exec -a supermux-gh-query bash -c '
    q="$1"
    [ -z "$q" ] && exit 0
    sleep 1
    gh search repos --json=name,owner --jq="map(\"\(.owner.login)/\(.name)\")[]" --match=name "$q" 2>/dev/null || true
  ' _ "$query"
}

# List available commands as: name \t padded-name \t dimmed-origin
# Builtins come first so resolution order matches bash; first PATH hit wins.
function get_commands {
  local dim=$'\033[2m' reset=$'\033[0m'
  {
    local b
    while read -r b; do
      printf '%s\t%s\n' "$b" "builtin"
    done < <(compgen -b)

    local dir f
    local IFS=':'
    for dir in $PATH; do
      [ -d "$dir" ] || continue
      for f in "$dir"/*; do
        [ -x "$f" ] && [ ! -d "$f" ] && printf '%s\t%s\n' "${f##*/}" "$dir"
      done
    done
  } | awk -F'\t' -v home="${HOME:-}" -v dim="$dim" -v reset="$reset" '
    !seen[$1]++ {
      origin = $2
      if (home != "" && index(origin, home) == 1) origin = "~" substr(origin, length(home) + 1)
      printf "%s\t%-32s\t%s%s%s\n", $1, $1, dim, origin, reset
    }'
}

# First whitespace-separated word of the query
function supermux_command_word {
  local q="${1:-}"
  q="${q#"${q%%[![:space:]]*}"}"
  echo "${q%%[[:space:]]*}"
}

# Prints how a command resolves (builtin/keyword/path); fails if not runnable.
# Functions are ignored, as only supermux internals would show up.
function supermux_command_kind {
  local word="$1" kind
  kind="$(type -t "$word" 2>/dev/null || true)"
  case "$kind" in
    builtin|keyword)
      echo "$kind"
      return 0
      ;;
  esac
  type -P "$word" 2>/dev/null
}

# Command line to run: the query if its command is valid, otherwise the
# selected command with the query's arguments.
function supermux_command_resolve {
  local q="${1:-}" sel="${2:-}"
  q="${q#"${q%%[![:space:]]*}"}"
  q="${q%"${q##*[![:space:]]}"}"
  local word="${q%%[[:space:]]*}"
  local rest=""
  [[ "$q" == *[[:space:]]* ]] && rest="${q#*[[:space:]]}"

  if [ -z "$word" ]; then
    echo "$sel"
  elif [ -z "$sel" ] || supermux_command_kind "$word" >/dev/null; then
    echo "$q"
  else
    echo "$sel${rest:+ $rest}"
  fi
}

function supermux_command_complete {
  local q="${1:-}" sel="${2:-}"
  [ -z "$sel" ] && { echo "$q"; return 0; }
  q="${q#"${q%%[![:space:]]*}"}"
  local rest=""
  [[ "$q" == *[[:space:]]* ]] && rest="${q#*[[:space:]]}"
  echo "$sel ${rest}"
}

# Usage: supermux_command_run <exec|shell> <query> <selection>
# exec runs the command directly (popup closes on exit); shell wraps it in an
# interactive bash that stays open. Builtins/keywords always need the shell.
function supermux_command_run {
  local how="$1" cmd word
  cmd="$(supermux_command_resolve "${2:-}" "${3:-}")"
  [ -z "$cmd" ] && return 0
  word="$(supermux_command_word "$cmd")"
  case "$(type -t "$word" 2>/dev/null || true)" in
    builtin|keyword) how="shell" ;;
  esac
  if [ "$how" = "exec" ]; then
    popupmux launch --exec "$cmd"
  else
    popupmux launch "$cmd"
  fi
}

function supermux_command_manpage {
  local word="$1" kind="$2"
  local dim=$'\033[2m' reset=$'\033[0m'
  echo
  if [ "$kind" = "builtin" ] || [ "$kind" = "keyword" ]; then
    help "$word" 2>/dev/null && return 0
  fi
  if man -w "$word" >/dev/null 2>&1; then
    local page
    page="$(MANPAGER=cat GROFF_NO_SGR=1 MANWIDTH="${FZF_PREVIEW_COLUMNS:-80}" man "$word" 2>/dev/null | sed $'s/\033\\[[0-9;]*m//g' | col -bx)"
    if command -v bat >/dev/null 2>&1; then
      bat --language=man --style=plain --color=always <<<"$page"
    else
      echo "$page"
    fi
  else
    echo "${dim}No manual entry for ${word}${reset}"
  fi
}

function supermux_command_preview {
  local q="${1:-}" sel="${2:-}"
  local green=$'\033[32m' red=$'\033[31m' bold=$'\033[1m' dim=$'\033[2m' reset=$'\033[0m'
  local word target kind
  word="$(supermux_command_word "$q")"
  target="${word:-$sel}"
  [ -z "$target" ] && return 0

  if ! kind="$(supermux_command_kind "$target")"; then
    echo "${red}✘${reset} ${bold}${target}${reset}: not a valid command"
    [ -z "$sel" ] || [ "$sel" = "$target" ] && return 0
    target="$sel"
    kind="$(supermux_command_kind "$target")" || return 0
    echo "${dim}enter runs selection instead${reset}"
  fi

  local origin="$kind"
  if [ -e "$kind" ]; then
    local resolved
    resolved="$(realpath "$kind" 2>/dev/null || echo "$kind")"
    [ "$resolved" != "$kind" ] && origin="$kind -> $resolved"
  fi
  echo "${green}✔${reset} ${bold}${target}${reset} ${dim}${origin}${reset}"

  supermux_command_manpage "$target" "$kind"
}

export -f shortpath shorten_path format_path get_pad_width get_tmux_sessions get_tmux_windows zoxide_query tmux_new_session find_session_by_path find_session_by_kube prompt_session_conflict zoxide_open ic_connect get_github_user github_clone_and_open supermux_github_query
export -f get_commands supermux_command_word supermux_command_kind supermux_command_resolve supermux_command_complete supermux_command_run supermux_command_manpage supermux_command_preview

# -----------------------------------------------------------------------------
# Mode DSL Configuration Helpers
# -----------------------------------------------------------------------------

function mode_prompt {
  PROMPT="$1"
}

function mode_preview {
  PREVIEW_CMD="$1"
}

function mode_source {
  RAW_SOURCE_CMD="$1"
  shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --delimiter)
        DELIM="$2"
        shift 2
        ;;
      --display)
        DISPLAY_FIELDS="$2"
        shift 2
        ;;
      --search)
        SEARCH_FIELDS="$2"
        shift 2
        ;;
      --order-by)
        ORDER_BY="$2"
        shift 2
        ;;
      --order-opts)
        ORDER_OPTS="$2"
        shift 2
        ;;
      --output)
        OUTPUT_FIELD="$2"
        shift 2
        ;;
      --no-sort|+s)
        NO_SORT=1
        shift
        ;;
      --live)
        IS_LIVE=1
        shift
        ;;
      *)
        shift
        ;;
    esac
  done
}

function mode_action {
  # Usage: mode_action <key> <description> <mode:become|reload> <command>
  ACTION_KEYS+=("$1")
  ACTION_DESCS+=("$2")
  ACTION_MODES+=("${3:-become}")
  ACTION_CMDS+=("$4")
}

function mode_bind {
  # Usage: mode_bind <key> <description> <target>
  KB_KEYS+=("$1")
  KB_DESCS+=("${2:-}")
  KB_ACTIONS+=("$3")
}

# -----------------------------------------------------------------------------
# Mode Definitions
# -----------------------------------------------------------------------------

function mode_sessions {
  mode_prompt "sessions> "
  mode_source "get_tmux_sessions" \
    --delimiter $'\t' \
    --display 2 \
    --order-by 3 \
    --order-opts "-n -r" \
    --output 1
  mode_preview "tmux capture-pane -p -e -t {1}"

  mode_action enter   "select"  become "tmux switch-client -t {1}"
  mode_action ctrl-x  "delete"  reload "tmux_cleanup -s {1}"

  mode_bind ctrl-w      "windows"   mode:windows
  mode_bind ctrl-o      "zoxide"    mode:zoxide
  mode_bind ctrl-i      "inventory" mode:inventory
  mode_bind ctrl-h      "github"    mode:github
  mode_bind ctrl-r      "command"   mode:command
  mode_bind ctrl-s      "sofka"     "popupmux launch sofka"
  mode_bind ctrl-g      "lazygit"   "popupmux launch lazygit"
  mode_bind esc         "exit"      abort
}

function mode_windows {
  mode_prompt "windows> "
  mode_source "get_tmux_windows" \
    --delimiter $'\t' \
    --display 2 \
    --order-by 3 \
    --order-opts "-n -r" \
    --output 1
  mode_preview "tmux capture-pane -p -e -t {1}"

  mode_action enter   "select"  become "tmux switch-client -t {1}"
  mode_action ctrl-x  "delete"  reload "tmux_cleanup -w {1}"

  mode_bind esc         "sessions"  mode:sessions
  mode_bind ctrl-o      "zoxide"    mode:zoxide
  mode_bind ctrl-i      "inventory" mode:inventory
  mode_bind ctrl-h      "github"    mode:github
  mode_bind ctrl-r      "command"   mode:command
}

function mode_zoxide {
  mode_prompt "zoxide> "
  mode_source "zoxide_query" \
    --delimiter $'\t' \
    --display 2 \
    --order-by 3 \
    --order-opts "-n -r" \
    --output 1 \
    --no-sort
  mode_preview 'test -f {1}/README.md && nvimpager -c {1}/README.md +"set ft=markdown" || test -f {1}/readme.md && nvimpager -c {1}/readme.md +"set ft=markdown" || tree -a -C -I .git -L 4 {1} 2>/dev/null || ls -la {1}'

  mode_action enter   "nvim"    become "zoxide_open {1} 'nvim -c \":lua require(\\\"persistence\\\").load()\"'"
  mode_action tab     "bash"    become "zoxide_open {1}"
  mode_action ctrl-x  "remove"  reload "zoxide remove {1}"

  mode_bind esc         "sessions"  mode:sessions
  mode_bind ctrl-w      "windows"   mode:windows
  mode_bind ctrl-i      "inventory" mode:inventory
  mode_bind ctrl-h      "github"    mode:github
  mode_bind ctrl-r      "command"   mode:command
  mode_bind ctrl-o      "sort"      toggle-sort
}

function mode_inventory {
  mode_prompt "inventory> "
  mode_source "ic get clusters -q -o json 2>/dev/null | jq -r '.clusters[].id' 2>/dev/null || true" \
    --delimiter $'\t' \
    --display 1 \
    --search 1 \
    --output 1
  mode_preview "ic get cluster -q {1}"

  mode_action enter   "sofka"   become "ic_connect {1} 'sleep 0.1; sofka'"
  mode_action tab     "bash"    become "ic_connect {1}"

  mode_bind esc         "sessions"  mode:sessions
  mode_bind ctrl-w      "windows"   mode:windows
  mode_bind ctrl-o      "zoxide"    mode:zoxide
  mode_bind ctrl-h      "github"    mode:github
  mode_bind ctrl-r      "command"   mode:command
}

function mode_github {
  mode_prompt "github> "
  mode_source "supermux_github_query {q}" --live
  mode_preview "gh repo view {1}"

  mode_action enter   "nvim"  become "github_clone_and_open {1} 'nvim -c \":lua require(\\\"persistence\\\").load()\"'"
  mode_action tab     "bash"  become "github_clone_and_open {1}"

  mode_bind esc       "sessions"  mode:sessions
  mode_bind ctrl-w    "windows"   mode:windows
  mode_bind ctrl-o    "zoxide"    mode:zoxide
  mode_bind ctrl-i    "inventory" mode:inventory
  mode_bind ctrl-r    "command"   mode:command
}

function mode_command {
  mode_prompt "command> "
  mode_source "get_commands" \
    --delimiter $'\t' \
    --display 2.. \
    --search 1 \
    --order-by 1 \
    --output 1
  mode_preview "supermux_command_preview {q} {1}"

  mode_action enter     "run"   become "supermux_command_run exec {q} {1}"
  mode_action alt-enter "shell" become "supermux_command_run shell {q} {1}"

  # Only match the command name, so arguments typed after it don't filter
  mode_bind start,change ""         "fzf:transform-search(supermux_command_word {q})"
  mode_bind tab         "complete"  "fzf:transform-query(supermux_command_complete {q} {1})"
  mode_bind esc         "sessions"  mode:sessions
  mode_bind ctrl-w      "windows"   mode:windows
  mode_bind ctrl-o      "zoxide"    mode:zoxide
  mode_bind ctrl-h      "github"    mode:github
}

# -----------------------------------------------------------------------------
# Runner
# -----------------------------------------------------------------------------

function _exec_fzf {
  local mode="$1"
  local query="$2"

  tmux set-option -p @supermux_mode "$mode" 2>/dev/null || true

  # Reset DSL state
  PROMPT="${mode}> "
  DELIM=$'\t'
  DISPLAY_FIELDS=""
  SEARCH_FIELDS=""
  ORDER_BY=""
  ORDER_OPTS=""
  OUTPUT_FIELD=1
  NO_SORT=0
  IS_LIVE=0
  PREVIEW_CMD=""
  RAW_SOURCE_CMD=""

  ACTION_KEYS=()
  ACTION_DESCS=()
  ACTION_MODES=()
  ACTION_CMDS=()
  ACTION_LABELS=()
  ACTION_BINDS=()

  KB_KEYS=()
  KB_DESCS=()
  KB_ACTIONS=()
  KB_LABELS=()
  KB_BINDS=()

  local mode_fn="mode_${mode}"
  if ! declare -F "$mode_fn" >/dev/null 2>&1; then
    echo "supermux: unknown mode '$mode'" >&2
    exit 1
  fi

  "$mode_fn"

  # Build full source pipeline with ordering if specified
  local full_source_cmd="$RAW_SOURCE_CMD"
  if [ "$IS_LIVE" -eq 1 ]; then
    full_source_cmd="echo -n"
  else
    local sort_delim="$DELIM"
    if [ "$sort_delim" = '\t' ] || [ "$sort_delim" = "\\t" ]; then
      sort_delim=$'\t'
    fi
    if [ -n "$ORDER_BY" ]; then
      full_source_cmd="$full_source_cmd | sort -t'$sort_delim' -k${ORDER_BY},${ORDER_BY} $ORDER_OPTS"
    fi
  fi

  # Replace placeholder in preview command
  if [ -n "$PREVIEW_CMD" ]; then
    PREVIEW_CMD="${PREVIEW_CMD//\{\}/\{$OUTPUT_FIELD\}}"
  fi

  # Build action bindings
  for idx in "${!ACTION_KEYS[@]}"; do
    local key="${ACTION_KEYS[$idx]}"
    local desc="${ACTION_DESCS[$idx]}"
    local act_mode="${ACTION_MODES[$idx]}"
    local cmd="${ACTION_CMDS[$idx]}"
    cmd="${cmd//\{\}/\{$OUTPUT_FIELD\}}"

    local display_key="${key/ctrl-/^}"
    ACTION_LABELS+=("${display_key}:${desc}")

    if [ "$act_mode" = "reload" ]; then
      ACTION_BINDS+=(--bind="$key:execute($cmd)+reload($full_source_cmd)")
    else
      ACTION_BINDS+=(--bind="$key:become($cmd)")
    fi
  done

  # Build keybinding bindings
  for idx in "${!KB_KEYS[@]}"; do
    local kb="${KB_KEYS[$idx]}"
    local desc="${KB_DESCS[$idx]}"
    local kb_action="${KB_ACTIONS[$idx]}"

    local display_kb="${kb/ctrl-/^}"
    [ -n "$desc" ] && KB_LABELS+=("${display_kb}:${desc}")

    if [[ "$kb_action" == mode:* ]]; then
      local target="${kb_action#mode:}"
      KB_BINDS+=(--bind="$kb:become($SELF --mode $target --query {q})")
    elif [ "$kb_action" = "abort" ]; then
      KB_BINDS+=(--bind="$kb:abort")
    elif [[ "$kb_action" == toggle-* ]] || [[ "$kb_action" == fzf:* ]]; then
      local act="${kb_action#fzf:}"
      KB_BINDS+=(--bind="$kb:$act")
    else
      KB_BINDS+=(--bind="$kb:become($kb_action)")
    fi
  done

  local border_label="${ACTION_LABELS[*]}  ${KB_LABELS[*]}"

  local fzf_args=(
    --ansi
    --no-hscroll
    --prompt="$PROMPT"
    --cycle
    --delimiter="$DELIM"
    --border=bottom
    --border-label=" $border_label "
    --bind="ctrl-p:toggle-preview"
    "${ACTION_BINDS[@]}"
    "${KB_BINDS[@]}"
  )

  if [ "$IS_LIVE" -eq 1 ]; then
    fzf_args+=(
      --disabled
      --bind="change:reload-sync($RAW_SOURCE_CMD)"
      --bind="load:reload-sync($RAW_SOURCE_CMD)+unbind(load)"
    )
  else
    fzf_args+=(--bind="resize:reload($full_source_cmd)")
    if [ "$NO_SORT" -eq 1 ]; then
      fzf_args+=(--no-sort)
    fi
    if [ -n "$DISPLAY_FIELDS" ]; then
      fzf_args+=(--with-nth="$DISPLAY_FIELDS")
    fi
    if [ -n "$SEARCH_FIELDS" ]; then
      fzf_args+=(--nth="$SEARCH_FIELDS")
    fi
  fi

  if [ -n "$PREVIEW_CMD" ]; then
    fzf_args+=(
      --preview="($PREVIEW_CMD)"
      --preview-window="up,wrap"
    )
  fi

  if [ -n "$query" ]; then
    fzf_args+=(--query="$query")
  fi

  if [ -n "${SUPERMUX_DRY_RUN:-}" ]; then
    echo "MODE: $mode"
    echo "PROMPT: $PROMPT"
    echo "SOURCE: $full_source_cmd"
    echo "BORDER_LABEL: $border_label"
    echo "FZF_ARGS: ${fzf_args[*]}"
    return 0
  fi

  local exit_code=0
  eval "$full_source_cmd" | fzf "${fzf_args[@]}" || exit_code=$?

  if [ "$exit_code" -ne 130 ]; then
    exit "$exit_code"
  fi
}

function main {
  local mode="sessions"
  local query=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -m|--mode)
        mode="$2"
        shift 2
        ;;
      -q|--query)
        query="$2"
        shift 2
        ;;
      *)
        shift
        ;;
    esac
  done

  _exec_fzf "$mode" "$query"
}

main "$@"
