#!/usr/bin/env bash

set -Eeuo pipefail

function _main {
  _init_args "$@"
  _export_functions
  _exec_fzf && EXIT_CODE=0 || EXIT_CODE=$?

  # Ignore escape and interrupts
  if [ "$EXIT_CODE" -ne 130 ]; then
    exit "$EXIT_CODE"
  fi
}

function _init_args {
  optspec="x-:"
  while getopts "$optspec" optchar; do
    case "${optchar}" in
    -)
      case "${OPTARG}" in
      *)
        if [ "$OPTERR" = 1 ] && [ "${optspec:0:1}" != ":" ]; then
          echo "Unknown option --${OPTARG}" >&2
        fi
        ;;
      esac
      ;;
    *)
      if [ "$OPTERR" != 1 ] || [ "${optspec:0:1}" = ":" ]; then
        echo "Non-option argument: '-${OPTARG}'" >&2
      fi
      ;;
    esac
  done
}

function _export_functions {
  functions=()
  for f in $(declare -F | sed --quiet --regexp-extended 's/declare -f ([^_].*)/\1/p'); do
    functions+=("$f")
  done
  eval export -f "${functions[*]}"
}

function _exec_fzf {
  echo -n "" | fzf \
    --bind='backward-eof:change-prompt(> )+reload(load)+rebind(change)+unbind(backward-eof)' \
    --bind='change:transform(detect_mode {q})' \
    --bind='focus:transform-border-label(change_border_label {})' \
    --bind='load:reload(load)+unbind(load)+unbind(backward-eof)' \
    --bind='enter:become(action_primary {})' \
    --bind='tab:become(action_secondary {})' \
    --bind="ctrl-p:toggle-preview" \
    --bind='ctrl-g:become(launch_or_select lazygit)' \
    --bind='ctrl-i:become(launch_or_select k9s)' \
    --cycle \
    --delimiter='\t' \
    --nth=2 \
    --preview='(preview {})' \
    --preview-window=up,wrap \
    --with-nth=3,4
}

function launch_or_select {
  local cmd="$1"
  local target_win
  target_win="$(tmux list-windows -F "#{window_id};#{window_name};#{pane_current_command}" | \
    awk -v cmd="$cmd" -F';' '$2 == cmd || $3 == cmd {print $1; exit}')"

  if [ -n "$target_win" ]; then
    tmux select-window -t "$target_win"
  else
    tmux new-window -c "$PWD" -n "$cmd" "bash -i -c '$cmd; exec bash'"
  fi
}

function detect_mode {
  case "$1" in
  'b ')
    match=1
    cmd="get_brew_upgrades"
    prompt="brew"
    ;;
  'c ')
    match=1
    cmd="get_commands"
    prompt="commands"
    ;;
  's ')
    match=1
    cmd="get_tmux_sessions"
    prompt="sessions"
    ;;
  'w ')
    match=1
    cmd="get_tmux_windows"
    prompt="windows"
    ;;
  'z ')
    match=1
    cmd="get_zoxide"
    prompt="zoxide"
    ;;
  'i ')
    match=1
    cmd="get_inventory"
    prompt="inventory"
    ;;
  'k ')
    match=1
    cmd="get_tmux_keys"
    prompt="keys"
    ;;
  'g ')
    match=1
    cmd="get_git_repos"
    prompt="git"
    ;;
  'm ')
    match=1
    cmd="get_manpages"
    prompt="manpages"
    ;;
  *) ;;
  esac
  if [ -n "${match:-}" ]; then
    echo "clear-query+change-prompt($prompt> )+reload($cmd)+unbind(change)+rebind(backward-eof)"
  fi
}

function load {
  get_tmux_sessions
}

function change_border_label {
  read -r TYPE FULL ICON NAME <<<"$1"
  case "$TYPE" in
  b)
    echo " 󰌑 upgrade "
    ;;
  c)
    echo " 󰌑 run  prompt "
    ;;
  g)
    echo " 󰌑 nvim  prompt "
    ;;
  i)
    echo " 󰌑 k9s  prompt "
    ;;
  k)
    echo " 󰌑 run "
    ;;
  m)
    echo " 󰌑 open "
    ;;
  s)
    echo " 󰌑 switch "
    ;;
  t)
    echo " 󰌑 switch "
    ;;
  z)
    echo " 󰌑 nvim  prompt "
    ;;
  *)
    echo ""
    ;;
  esac
}

function preview {
  IFS=$'\t' read -r TYPE FULL ICON NAME <<<"$1"
  case "$TYPE" in
  b)
    HOMEBREW_COLOR=1 HOMEBREW_GITHUB_API_TOKEN=$(gh auth token) brew info "$FULL"
    ;;
  c)
    man "$NAME" 2>/dev/null | nvimpager -c +"set ft=man"
    ;;
  g)
    README="$(find "$FULL" -maxdepth 1 -type f -iname readme.md)"
    if [ -n "$README" ]; then
      nvimpager -c "$README" +"set ft=markdown"
    else
      tree -a -C -I '.git' -L 5 "$FULL"
    fi
    ;;
  i)
    ic get cluster -q "$FULL"
    ;;
  k)
    tmux list-keys -Tprefix "${FULL//;/\\;}" | sed 's/bind-key\( -r\)\? -T prefix [^ ]\+ //'
    ;;
  m)
    man "$FULL" 2>/dev/null | nvimpager -c +"set ft=man"
    ;;
  s)
    local active_pane
    active_pane="$(tmux display-message -p -F '#{pane_id}' -t "$FULL" 2>/dev/null || true)"
    if [ -n "$active_pane" ]; then
      tmux capture-pane -p -e -t "$active_pane"
    fi
    ;;
  t)
    read -r ID _ <<<"$FULL"
    tmux capture-pane -p -e -t "$ID"
    ;;
  z)
    README="$(find "$FULL" -maxdepth 1 -type f -iname readme.md)"
    if [ -n "$README" ]; then
      nvimpager -c "$README" +"set ft=markdown"
    else
      tree -a -C -I '.git' -L 5 "$FULL"
    fi
    ;;
  esac
}

function action_primary {
  IFS=$'\t' read -r TYPE FULL ICON NAME <<<"$1"

  case "$TYPE" in
  b)
    HOMEBREW_GITHUB_API_TOKEN=$(gh auth token) brew upgrade "$FULL"
    ;;
  c)
    exec "$FULL"
    ;;
  g)
    local new_id
    new_id="$(tmux new-session -d -c "$FULL" -P -F '#{session_id}' bash -i -c "nvim -c ':lua require(\"persistence\").load()';exec bash")"
    tmux switch-client -t "$new_id"
    ;;
  i)
    local new_id new_name
    new_id="$(tmux new-session -c "$HOME" -d -e "KUBECACHEDIR=$HOME/.kube/cache" -P -F '#{session_id}' bash -i -c 'sleep 0.1; k9s; exec bash')"
    new_name="${new_id#\$}"
    ic get cluster-kubeconfig --cluster-name "$FULL" >"$HOME/.kube/config-tmux-${new_name}"
    tmux switch-client -t "$new_id"
    ;;
  k)
    eval "tmux $(tmux list-keys -Tprefix "${FULL//;/\\;}" | sed 's/bind-key\( -r\)\? -T prefix [^ ]\+ //')"
    ;;
  m)
    man "$FULL"
    ;;
  s)
    tmux switch-client -t "$FULL"
    ;;
  t)
    tmux switch-client -t "$FULL"
    ;;
  z)
    local new_id
    new_id="$(tmux new-session -d -c "$FULL" -P -F '#{session_id}' bash -i -c "nvim -c ':lua require(\"persistence\").load()';exec bash")"
    tmux switch-client -t "$new_id"
    ;;
  esac
}

function action_secondary {
  IFS=$'\t' read -r TYPE FULL ICON NAME <<<"$1"

  case "$TYPE" in
  c)
    bash_prompt "$NAME"
    ;;
  g)
    local new_id
    new_id="$(tmux new-session -d -c "$FULL" -P -F '#{session_id}' bash)"
    tmux switch-client -t "$new_id"
    ;;
  i)
    local new_id new_name
    new_id="$(tmux new-session -c "$HOME" -d -e "KUBECACHEDIR=$HOME/.kube/cache" -P -F '#{session_id}' bash -i -c 'sleep 0.1; exec bash')"
    new_name="${new_id#\$}"
    ic get cluster-kubeconfig --cluster-name "$FULL" >"$HOME/.kube/config-tmux-${new_name}"
    tmux switch-client -t "$new_id"
    ;;
  s)
    tmux switch-client -t "$FULL"
    ;;
  z)
    local new_id
    new_id="$(tmux new-session -d -c "$FULL" -P -F '#{session_id}' bash)"
    tmux switch-client -t "$new_id"
    ;;
  esac
}

function get_brew_upgrades {
  local FULL ICON NAME TYPE
  ICON="$(color blue )"
  TYPE="b"
  HOMEBREW_NO_ENV_HINTS=1 HOMEBREW_GITHUB_API_TOKEN=$(gh auth token) brew upgrade --dry-run --quiet 2>/dev/null | sed '/==> Would upgrade/d' |
    awk '{print $1}' |
    while read -r NAME; do
      FULL="$NAME"
      echo -e "$TYPE\t$FULL\t$ICON\t$NAME"
    done
}

function get_commands {
  local EXTRA_ICONS FULL ICON NAME TYPE
  ICON="$(color magenta 󰘔)"
  TYPE="c"
  compgen -c |
    sort --unique |
    while read -r NAME; do
      FULL="$(type -p "$NAME")"
      if [ -z "$FULL" ]; then
        continue
      fi
      local EXTRA_ICONS=""
      if [ "$FULL" = "$HOME/.nix-profile/bin/$NAME" ]; then
        EXTRA_ICONS+=" $(color cyan 󱄅)"
      elif [ "$FULL" = "$HOME/bin/$NAME" ]; then
        EXTRA_ICONS+=" $(color green )"
      fi
      echo -e "$TYPE\t$FULL\t$ICON$EXTRA_ICONS\t$NAME"
    done
}

function get_git_repos {
  local FULL GIT_DIR NORMALIZED PARENT CHILD NAME ICON TYPE
  ICON="$(color yellow )"
  TYPE="g"
  fd -g .git -HL -t d -d 10 --prune ~/Repositories/ |
    while read -r GIT_DIR; do
      GIT_DIR="${GIT_DIR%/}"
      FULL="${GIT_DIR%/.git}"
      NORMALIZED="${FULL/*\/Repositories\//}"
      if [[ "$NORMALIZED" == *"/"* ]]; then
        PARENT="${NORMALIZED%/*}"
        CHILD="${NORMALIZED##*/}"
      else
        PARENT="."
        CHILD="$NORMALIZED"
      fi
      NAME="$(color graydark "$PARENT")/$CHILD"
      echo -e "$TYPE\t$FULL\t$ICON\t$NAME"
    done
}

function get_inventory {
  local FULL ICON NAME TYPE
  ICON="$(color magenta )"
  TYPE="i"
  ic get clusters -q -o json |
    jq -r '.clusters[].id' |
    while read -r NAME; do
      FULL="$NAME"
      echo -e "$TYPE\t$FULL\t$ICON\t$NAME"
    done
}

function get_manpages {
  local FULL ICON NAME TYPE
  ICON="$(color blue )"
  TYPE="m"
  # shellcheck disable=SC2046
  find -L $(manpath | tr ':' ' ') -type f \( -name "*.[0-9]" -or -name "*.[0-9].gz" \) -exec sh -c 'for f; do echo "${f##*/}"; done' _ {} + 2>/dev/null |
    while read -r NAME; do
      FULL="$(basename "$NAME" .gz)"
      echo -e "$TYPE\t$FULL\t$ICON\t$NAME"
    done
}

function get_tmux_keys {
  local FULL ICON NAME TYPE
  ICON="$(color magenta )"
  TYPE="k"
  tmux list-keys -N -Tprefix |
    while read -r FULL NAME; do
      echo -e "$TYPE\t$FULL\t$ICON\t$NAME"
    done
}

function get_tmux_sessions {
  local FULL ICON NAME TYPE
  ICON="$(color cyan )"
  TYPE="s"
  local current_sess_name
  current_sess_name="$(tmux display-message -p '#{client_session}')"

  tmux list-sessions -F "#{session_id};#{session_name};#{session_activity};#{session_active}" -f '#{?#{m:_popup_*,#{session_name}},0,1}' | \
    sort -t';' -k3 -n -r | \
    while IFS=';' read -r sess_id sess_name sess_activity sess_active || [[ -n "$sess_active" ]]; do
      if [ "$sess_name" = "$current_sess_name" ]; then
        continue
      fi
      FULL="$sess_id"
      local kube_ctx
      kube_ctx=$(kubemux "$sess_id" || true)
      local active_win_id
      active_win_id="$(tmux display-message -p -t "$sess_id" '#{window_id}' 2>/dev/null || true)"
      local win_path
      if [ -n "$active_win_id" ]; then
        win_path="$(pathmux "$active_win_id")"
      else
        win_path=""
      fi
      # Display: path kube_ctx (no session number, no current command icons!)
      if [ -n "$win_path" ]; then
        NAME="${win_path}${kube_ctx:+ $kube_ctx}"
      else
        NAME="$sess_name${kube_ctx:+ $kube_ctx}"
      fi
      echo -e "$TYPE\t$FULL\t$ICON\t$NAME"
    done
}

function get_tmux_windows {
  local FULL ICON NAME TYPE
  ICON="$(color green )"
  TYPE="t"
  tmux list-windows -F "#{window_id};#{session_id}" |
    while IFS=';' read -r win_id sess_id || [[ -n "$sess_id" ]]; do
      FULL="$win_id"
      local kube_ctx
      kube_ctx=$(kubemux "$sess_id" || true)
      local win_id_clean win_icons win_path
      win_id_clean="$(echo "$win_id" | tr -d "'")"
      win_icons="$(windowmux "$win_id_clean" active)"
      win_path="$(pathmux "$win_id_clean")"
      NAME="${win_icons}${win_path:+ $win_path}${kube_ctx:+ $kube_ctx}"
      echo -e "$TYPE\t$FULL\t$ICON\t$NAME"
    done
}

function get_zoxide {
  local EXTRA_ICONS FULL ICON NAME TYPE
  ICON="$(color blue )"
  TYPE="z"
  zoxide query --list |
    while read -r NAME; do
      EXTRA_ICONS=""
      FULL="$NAME"
      if [ -d "$NAME/.git" ]; then
        EXTRA_ICONS+=" $(color yellow )"
      fi
      echo -e "$TYPE\t$FULL\t$ICON$EXTRA_ICONS\t$NAME"
    done
}

function color {
  declare -x color_reset color
  color=
  color_reset="$(tput sgr0)"

  case $1 in
  black)
    color="$(tput setaf 0)"
    ;;
  blue)
    color="$(tput setaf 4)"
    ;;
  cyan)
    color="$(tput setaf 6)"
    ;;
  default)
    color="$color_reset"
    ;;
  graydark)
    color="$(tput setaf 8)"
    ;;
  graylight)
    color="$(tput setaf 7)"
    ;;
  green)
    color="$(tput setaf 2)"
    ;;
  magenta)
    color="$(tput setaf 5)"
    ;;
  red)
    color="$(tput setaf 1)"
    ;;
  yellow)
    color="$(tput setaf 3)"
    ;;
  white)
    color="$(tput setaf 15)"
    ;;
  *)
    echo "[WRN] Color must be one of: black, blue, cyan, default, green, magenta, red, yellow, white" >&2
    ;;
  esac

  echo -e "$color$2$color_reset"
}

_main "$@"
