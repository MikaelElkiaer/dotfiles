#!/usr/bin/env bash

set -Eeuo pipefail

# Source the helpers to import set-color and shortname as pure bash functions
# with absolutely zero process fork overhead when executing them.
source "$(dirname "${BASH_SOURCE[0]}")/set-color"
source "$(dirname "${BASH_SOURCE[0]}")/shortname"

function main() {
  WINDOW_ID="$1"
  STATE="${2:-}"

  if [[ "$STATE" == "active" || "$STATE" == "inactive" ]]; then
    format_window_list "$WINDOW_ID" "$STATE"
    return
  fi

  # Original backward-compatible behavior (path + icon)
  IFS=$';' read -r path command title bell < <(tmux display-message -p -F '#{pane_current_path};#{pane_current_command};#{pane_title};#{window_bell_flag}' -t "$WINDOW_ID")

  icon=$(get_app_icon "$command")
  RESULT="$(set-color 12)${icon} $(set-color reset)"

  if [[ "$path" == "$HOME"* ]]; then
    path="${path/$HOME/'~'}"
  fi

  if [ "$command" == "ssh" ]; then
    local _host _path
    _host="${title%%:*}"
    _host="${_host#*@}"
    _path="${title#*:}"
    path="$_path"
    RESULT+="${_host}"
  fi

  IFS='/' read -ra PATH_PARTS <<<"$path"
  if [[ "${#PATH_PARTS[@]}" -gt 1 ]]; then
    RESULT+="$(set-color 8)"
  fi
  for i in "${!PATH_PARTS[@]}"; do
    if [[ -z "${PATH_PARTS[$i]}" ]]; then
      continue
    elif [[ "$i" -eq 0 ]]; then
      RESULT+="${PATH_PARTS[$i]}/"
    elif [[ "$i" -eq $(("${#PATH_PARTS[@]}" - 1)) ]]; then
      RESULT+="$(set-color reset)"
      RESULT+="${PATH_PARTS[$i]}/"
    elif [[ -v NOSHORT ]]; then
      RESULT+="${PATH_PARTS[$i]}/"
    else
      RESULT+="$(shortname "${PATH_PARTS[$i]}")/"
    fi
  done

  if [ "$bell" -eq 1 ]; then
    RESULT+=" $(set-color 1)󰈻$(set-color reset)"
  fi

  echo "$RESULT"
}

function get_app_icon() {
  case "$1" in
  "bash" | "sh")
    echo ""
    ;;
  "k9s"|".k9s-wrapped")
    echo "󱃾"
    ;;
  "nvim")
    echo ""
    ;;
  "ssh")
    echo "󰍹"
    ;;
  "lazygit")
    echo ""
    ;;
  *)
    echo " "
    ;;
  esac
}

function format_window_list() {
  local window_id="$1"
  local status="$2"
  local result=""

  while IFS=';' read -r pane_active pane_command || [[ -n "$pane_command" ]]; do
    local icon
    icon=$(get_app_icon "$pane_command")

    if [ "$status" = "active" ]; then
      if [ "$pane_active" -eq 1 ]; then
        # Active pane in active window -> colored blue (color 12)
        result+="$(set-color 12)${icon} $(set-color reset)"
      else
        # Inactive pane in active window -> white by default (color 15)
        result+="$(set-color 15)${icon} $(set-color reset)"
      fi
    else
      # Window is inactive -> dimmed (color 8)
      result+="$(set-color 8)${icon} $(set-color reset)"
    fi
  done < <(tmux list-panes -t "$window_id" -F "#{pane_active};#{pane_current_command}")

  # Append Braille empty block (U+2800) to prevent tmux from stripping the trailing space
  echo -n "${result}⠀"
}

main "$@"
