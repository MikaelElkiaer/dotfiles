#!/usr/bin/env bash

set -Eeuo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/set-color"
source "$(dirname "${BASH_SOURCE[0]}")/pathmux"

function get_app_icon() {
  case "$1" in
  "bash" | "sh")
    echo " "
    ;;
  "sofka"|"k9s"|".k9s-wrapped")
    echo "󱃾 "
    ;;
  "nvim")
    echo " "
    ;;
  "ssh")
    echo "󰍹 "
    ;;
  "lazygit")
    echo " "
    ;;
  *)
    echo " "
    ;;
  esac
}

function format_window_list() {
  local window_id="$1"
  local status="$2"
  local result=""

  while IFS=';' read -r pane_active pane_command || [[ -n "$pane_command" ]]; do
    local icon
    icon=$(get_app_icon "$pane_command")

    if [ "$status" = "active" ]; then
      result+="$(set-color 15)${icon}$(set-color reset)"
    else
      result+="$(set-color 8)${icon}$(set-color reset)"
    fi
  done < <(tmux list-panes -t "$window_id" -F "#{pane_active};#{pane_current_command}")

  # Check window bell flag
  local bell
  bell="$(tmux display-message -p -t "$window_id" '#{window_bell_flag}' 2>/dev/null || echo 0)"
  if [ "$bell" -eq 1 ]; then
    result+=" $(set-color 1)󰈻$(set-color reset)"
  fi

  echo -n "${result}"
}

function windowmux() {
  local window_id="$1"
  local state="${2:-}"

  if [[ "$state" == "active" || "$state" == "inactive" ]]; then
    format_window_list "$window_id" "$state"
    return
  fi

  # Original backward-compatible behavior (path + icon)
  local path command title bell
  IFS=$';' read -r path command title bell < <(tmux display-message -p -F '#{pane_current_path};#{pane_current_command};#{pane_title};#{window_bell_flag}' -t "$window_id")

  local icon
  icon=$(get_app_icon "$command")
  local icon_str="$(set-color 12)${icon} $(set-color reset)"

  echo -n "$icon_str"
  format_path "$path" "$command" "$title" "$bell"
  echo ""
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  windowmux "$@"
fi
