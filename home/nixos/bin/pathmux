#!/usr/bin/env bash

set -Eeuo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/shortpath"

function format_path() {
  local path="$1"
  local command="${2:-}"
  local title="${3:-}"
  local bell="${4:-0}"

  local prefix=""
  if [ "$command" == "ssh" ]; then
    local _host _path
    _host="${title%%:*}"
    _path="${title#*:}"
    path="$_path"
    prefix="${_host}  "
  fi

  local bell_opt=()
  if [ "$bell" -eq 1 ]; then
    bell_opt=(-b)
  fi

  local sp
  sp="$(shortpath "${bell_opt[@]}" "$path")"
  echo "${prefix}${sp}"
}

function pathmux() {
  local window_id="$1"
  local path command title bell
  IFS=$';' read -r path command title bell < <(tmux display-message -p -F '#{pane_current_path};#{pane_current_command};#{pane_title};#{window_bell_flag}' -t "$window_id")

  format_path "$path" "$command" "$title" "$bell"
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  pathmux "$@"
fi
