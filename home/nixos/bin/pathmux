#!/usr/bin/env bash

set -Eeuo pipefail

source "$(dirname "${BASH_SOURCE[0]}")/shortpath"

function main() {
  local window_id="$1"

  IFS=$';' read -r path command title bell < <(tmux display-message -p -F '#{pane_current_path};#{pane_current_command};#{pane_title};#{window_bell_flag}' -t "$window_id")

  local prefix=""
  if [ "$command" == "ssh" ]; then
    local _host _path
    _host="${title%%:*}"
    _host="${_host#*@}"
    _path="${title#*:}"
    path="$_path"
    prefix="${_host} "
  fi

  local bell_opt=()
  if [ "$bell" -eq 1 ]; then
    bell_opt=(-b)
  fi

  echo -n "$prefix"
  shortpath "${bell_opt[@]}" "$path"
  echo ""
}

main "$@"
